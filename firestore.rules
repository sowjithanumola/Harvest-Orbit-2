rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sensors collection
    match /sensors/{deviceId} {
      // Allow anyone to read sensor data so guest mode and active monitoring works
      allow read: if true;
      // In a production app, writes would be restricted to specific device IDs or service accounts.
      // For now, we allow authenticated users to update for testing, 
      // but the primary writer is the server-side sensor ingress.
      allow write: if request.auth != null;
    }
    
    // User specific data if we add any in future
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
